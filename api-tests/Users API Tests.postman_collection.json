{
  "info": {
    "_postman_id": "ce66cdc5-9213-4368-95e9-5039f2dd7f33",
    "name": "Users API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "40208494"
  },
  "item": [
    {
      "name": "All User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "pm.test(\"Response is a non-empty array\", function () {\r",
              "    const data = pm.response.json();\r",
              "    pm.expect(data).to.be.an('array');\r",
              "    pm.expect(data).to.have.length.above(0);\r",
              "});\r",
              "pm.test(\"Each user has id, name and email\", function () {\r",
              "    const users = pm.response.json();\r",
              "\r",
              "    users.forEach(function (user) {\r",
              "        pm.expect(user).to.have.property('id');\r",
              "        pm.expect(user).to.have.property('name');\r",
              "        pm.expect(user).to.have.property('email');\r",
              "    });\r",
              "});\r",
              "const users = pm.response.json();\r",
              "const userId = users[0].id;\r",
              "\r",
              "pm.collectionVariables.set(\"userId\", userId);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "packages": {},
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/users",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Update User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "pm.test(\"Returned id matches saved id\", function () {\r",
              "    const response = pm.response.json();\r",
              "    const savedId = Number(pm.collectionVariables.get(\"userId\"));\r",
              "\r",
              "    pm.expect(response.id).to.eql(savedId);\r",
              "});\r",
              "pm.test(\"phone is not empty\",function(){\r",
              "    const response =pm.response.json();\r",
              "    pm.expect(response.phone).to.not.be.empty;\r",
              "});\r",
              "pm.test(\"Returned name matches updated name\", function () {\r",
              "    const response = pm.response.json();\r",
              "    const updatedName = pm.collectionVariables.get(\"newName\");\r",
              "    pm.expect(response.name).to.eql(updatedName);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const name = pm.variables.replaceIn(\"{{$randomFullName}}\");\r",
              "pm.collectionVariables.set(\"newName\", name);\r",
              "\r",
              "const email = pm.variables.replaceIn(\"{{$randomEmail}}\");\r",
              "pm.collectionVariables.set(\"newEmail\", email);\r",
              "\r",
              "const companyName = pm.variables.replaceIn(\"{{$randomCompanyName}}\");\r",
              "pm.collectionVariables.set(\"newCompanyName\", companyName);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"id\": 1,\r\n    \"name\": \"{{newName}}\",\r\n    \"username\": \"Bret\",\r\n    \"email\": \"{{newEmail}}\",\r\n    \"address\": {\r\n        \"street\": \"Kulas Light\",\r\n        \"suite\": \"Apt. 556\",\r\n        \"city\": \"Gwenborough\",\r\n        \"zipcode\": \"92998-3874\",\r\n        \"geo\": {\r\n            \"lat\": \"-37.3159\",\r\n            \"lng\": \"81.1496\"\r\n        }\r\n    },\r\n    \"phone\": \"1-770-736-8031 x56442\",\r\n    \"website\": \"hildegard.org\",\r\n    \"company\": {\r\n        \"name\": \"{{$newCompanyName}}\",\r\n        \"catchPhrase\": \"Multi-layered client-server neural-net\",\r\n        \"bs\": \"harness real-time e-markets\"\r\n    }\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/users/{{userId}}",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        }
      },
      "response": []
    }
  ],
